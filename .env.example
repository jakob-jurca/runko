# Copy to .env and fill in your own values.

# Supabase project (Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NOTE: there is no AI key here on purpose.
#
# Anything named VITE_* is inlined into the browser bundle and is therefore
# public. The Groq key is held server-side as a Supabase secret and used only
# by the ai-proxy Edge Function:
#
#   supabase secrets set GROQ_API_KEY=gsk_...
#
# See supabase/functions/ai-proxy/README.md.

