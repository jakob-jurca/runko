# Copy to .env and fill in your own values.

# Supabase project (Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Groq API key (https://console.groq.com/keys) — the app uses the
# llama-3.3-70b-versatile model on Groq's free tier.
VITE_GROQ_API_KEY=

# --- Integrations (skeleton — leave empty until activated) ---
# Strava OAuth app credentials (https://www.strava.com/settings/api)
VITE_STRAVA_CLIENT_ID=
